{
  "permissions": {
    "deny": [
      "Bash(* --no-verify*)",
      "Bash(* --no-verify)",
      "Bash(* --amend*)",
      "Bash(* --amend)",
      "Bash(* --no-gpg-sign*)",
      "Bash(* --no-gpg-sign)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git reset --hard)",
      "Bash(git reset * --hard*)",
      "Bash(git reset * --hard)",
      "Bash(git clean *)",
      "Bash(git clean)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -Rf*)",
      "Bash(rm -rF*)",
      "Bash(rm -r -f*)",
      "Bash(rm -f -r*)",
      "Bash(rm --recursive --force*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config * core.hooksPath*)",
      "PowerShell(* --no-verify*)",
      "PowerShell(* --amend*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(rm -rf*)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(* -Recurse * -Force*)",
      "PowerShell(git config core.hooksPath*)",
      "PowerShell(git config * core.hooksPath*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/brain-check.mjs --boot",
            "timeout": 30,
            "statusMessage": "Auto-auditoria del cerebro (brain:check --boot)…"
          },
          {
            "type": "command",
            "command": "node scripts/session-handoff.mjs --boot-echo",
            "timeout": 30,
            "statusMessage": "💓 Heartbeat + handoff de la sesión anterior…"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/brain-check.mjs --boot",
            "timeout": 30,
            "statusMessage": "Auto-auditoria del cerebro (brain:check --boot)…"
          },
          {
            "type": "command",
            "command": "node scripts/session-handoff.mjs --boot-echo --compact",
            "timeout": 30,
            "statusMessage": "💓 Heartbeat + re-inyección del arranque tras compactar…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/guard-destructivo.mjs",
            "timeout": 5,
            "statusMessage": "🛡️ guard-destructivo (2ª capa)…"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/session-handoff.mjs --precompact",
            "timeout": 30,
            "statusMessage": "Caja negra: volcando foto de sesión (TODO-28 #1)…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/session-handoff.mjs --end",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/session-handoff.mjs --end",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
