# Firebase Configuration — Get these from Firebase Console > Project Settings > Web App
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=bersaglio-jewelry.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bersaglio-jewelry
VITE_FIREBASE_STORAGE_BUCKET=bersaglio-jewelry.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-HS26X60DK3

# FCM Push Notifications — Firebase Console > Cloud Messaging > Web Push certificates
VITE_VAPID_KEY=REPLACE_WITH_VAPID_KEY

# App Check (anti-abuso / denial-of-wallet, F6) — Firebase Console > App Check >
# Apps > registrar la web app con reCAPTCHA v3. Pega aquí la "site key" (es PÚBLICA,
# va en el bundle). Sin esta var, App Check queda inactivo (el sitio sigue funcionando).
# Además, agrégala como secret del build en GitHub Actions para que el deploy la incluya.
VITE_RECAPTCHA_SITE_KEY=REPLACE_WITH_RECAPTCHA_V3_SITE_KEY
