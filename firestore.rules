rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    // F6 frente B (RBAC claims): el rol se lee PRIMERO del custom claim del token
    // (cero lecturas extra, S4) con fallback dual al doc users/{uid} durante la
    // transición (usuario sin backfill / claim aún no en el token). El claim lo
    // espeja SOLO la CF syncRoleClaim desde users/{uid}.role (fuente de verdad).
    // PRECEDENCIA: si el claim existe, MANDA (un claim desactualizado dura ≤1h de
    // token). Deprecar el fallback a +30 días del backfill (ADR §65).
    function getUserRole() {
      let claim = request.auth.token.get('role', null);
      return claim != null
          ? claim
          : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOwner() {
      return isAuth() && getUserRole() == 'owner';
    }

    function isAdmin() {
      return isAuth() && getUserRole() in ['owner', 'admin'];
    }

    function isEditor() {
      return isAuth() && getUserRole() in ['owner', 'admin', 'editor'];
    }

    // ─── CRM (cuentas por cobrar): validadores ───────────────────────────────────
    function nonEmptyStr(v) { return v is string && v.size() > 0; }
    // Optativos con el idiom seguro `!('campo' in d) || ...` (ver nota de S6: el
    // acceso a un campo ausente lanza error en reglas → presencia primero).
    // `hasOnly` = whitelist anti-inyección: bloquea saldoActual (lo escribe SOLO la
    // Cloud Function vía el movimiento de apertura) y cualquier campo no previsto.
    function clienteValido() {
      let d = request.resource.data;
      return nonEmptyStr(d.nombre)
          && d.keys().hasOnly(['nombre', 'telefono', 'whatsapp', 'cumpleanos', 'notas',
                               'vendedoraId', 'origen', 'activo',
                               'createdAt', 'createdBy', 'updatedAt'])
          && (!('vendedoraId' in d) || d.vendedoraId is string)
          && (!('telefono' in d)    || d.telefono is string);
    }
    // Vendedora = entidad de datos que gestiona Kary (no es un usuario auth).
    function vendedoraValida() {
      let d = request.resource.data;
      return nonEmptyStr(d.nombre)
          && d.keys().hasOnly(['nombre', 'activa', 'createdAt', 'createdBy', 'updatedAt'])
          && (!('activa' in d) || d.activa is bool);
    }
    // En CREATE: el asiento NO nace anulado y la auditoría de anulación es solo del
    // admin (vía update). El signo lo da el `tipo` (factura/apertura/ajuste suman;
    // abono resta). `monto`: factura/abono siempre ≥0; apertura/ajuste (solo admin)
    // pueden ser NEGATIVOS → saldo a favor inicial / corrección a la baja (ADR §43).
    function movimientoValido() {
      let d = request.resource.data;
      return d.tipo in ['apertura', 'factura', 'abono', 'ajuste']
          // entero-COP (spec §5.1): pesos SIN centavos. JS envía números enteros como
          // int; un decimal llega como double y se RECHAZA en la frontera de escritura.
          && d.monto is int
          && (d.tipo in ['apertura', 'ajuste'] || d.monto >= 0)
          && (!('descripcion' in d) || d.descripcion is string)
          // fecha real del hecho (mora, ADR §51); inmutable. Formato ISO 'YYYY-MM-DD'
          // validado server-side (el date-picker ya lo garantiza; defensa en profundidad).
          && (!('fecha' in d) || (d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && d.registradoPor == request.auth.uid
          && (!('anulado' in d) || d.anulado == false)
          && !('anuladoPor' in d) && !('anuladoEn' in d);
    }
    // Append-only: el ÚNICO update permitido sobre un movimiento es ANULARLO
    // (anulado false→true) + sellar auditoría (anuladoPor/anuladoEn + motivoAnulacion
    // obligatorio). Prohíbe reescribir tipo/monto/fecha/registradoPor/descripción del
    // asiento (solo esas 4 claves pueden cambiar). `.get('anulado', false)` tolera
    // movimientos legacy sin el campo.
    function anulacionValida() {
      let d = request.resource.data;
      return resource.data.get('anulado', false) == false
          && d.anulado == true
          && d.anuladoPor == request.auth.uid
          && nonEmptyStr(d.motivoAnulacion)
          && d.diff(resource.data).affectedKeys()
               .hasOnly(['anulado', 'anuladoPor', 'anuladoEn', 'motivoAnulacion']);
    }

    // ─── S6: validación de campos (tolerante a merge/partial updates) ────────────
    // En update con merge, request.resource.data = estado RESULTANTE completo, por
    // eso en `update` solo validamos TIPOS si el campo está presente (no exigimos
    // presencia → no rompe patches de imágenes ni docs legacy). En `create` sí
    // exigimos los obligatorios (name/code que el form de admin garantiza).
    // NOTA (reglas Firestore): acceder a un campo AUSENTE lanza error de evaluación
    // ("Property X is undefined on object") → NO usar `d.campo == null` para opcionales.
    // Idiom correcto: `!('campo' in d) || d.campo is <tipo>` (presencia primero).
    function pieceCreateValid() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0
          && d.code is string && d.code.size() > 0
          && (!('price' in d)    || d.price is number)
          && (!('featured' in d) || d.featured is bool)
          && (!('images' in d)   || d.images is list)
          && (!('specs' in d)    || d.specs is map);
    }
    function pieceTypesValid() {
      let d = request.resource.data;
      return (!('name' in d)       || d.name is string)
          && (!('code' in d)       || d.code is string)
          && (!('slug' in d)       || d.slug is string)
          && (!('collection' in d) || d.collection is string)
          && (!('featured' in d)   || d.featured is bool)
          && (!('price' in d)      || d.price is number)
          && (!('images' in d)     || d.images is list)
          && (!('specs' in d)      || d.specs is map);
    }
    function colCreateValid() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0
          && (!('featured' in d) || d.featured is bool);
    }
    function colTypesValid() {
      let d = request.resource.data;
      return (!('name' in d)     || d.name is string)
          && (!('slug' in d)     || d.slug is string)
          && (!('subtitle' in d) || d.subtitle is string)
          && (!('featured' in d) || d.featured is bool);
    }

    // ─── F6 frenos de gasto: forms públicos con forma EXACTA (anti spam / denial-of-wallet) ──
    // Whitelist de claves + tipos + tamaños máximos + serverTimestamp obligatorio
    // (`createdAt == request.time` ⇒ solo pasa serverTimestamp(), nunca fechas del cliente).
    // Payload espejo en js/firestore-service.js (submitReview / addSubscription / saveInquiry).
    function reviewCreateValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['pieceSlug', 'pieceName', 'author', 'rating', 'comment', 'email', 'approved', 'createdAt'])
          && nonEmptyStr(d.author)  && d.author.size()  <= 120
          && nonEmptyStr(d.comment) && d.comment.size() <= 2000
          && d.rating is number && d.rating >= 1 && d.rating <= 5
          && d.approved == false
          && (!('pieceSlug' in d) || (d.pieceSlug is string && d.pieceSlug.size() <= 200))
          && (!('pieceName' in d) || (d.pieceName is string && d.pieceName.size() <= 200))
          && (!('email' in d)     || (d.email is string && d.email.size() <= 254))
          && d.createdAt == request.time;
    }
    function subscriptionCreateValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'source', 'createdAt', 'active'])
          && d.email is string && d.email.size() >= 5 && d.email.size() <= 254
          && d.email.matches('^[^@]+@[^@]+[.][^@]+$')
          && (!('source' in d) || (d.source is string && d.source.size() <= 40))
          && (!('active' in d) || d.active == true)
          && d.createdAt == request.time;
    }
    function inquiryCreateValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'phone', 'message', 'pieceSlug', 'source', 'status', 'createdAt'])
          && nonEmptyStr(d.name)    && d.name.size()    <= 120
          && nonEmptyStr(d.message) && d.message.size() <= 3000
          && (!('email' in d) || (d.email is string && d.email.size() <= 254))
          && (!('phone' in d) || (d.phone is string && d.phone.size() <= 30))
          && (!('pieceSlug' in d) || d.pieceSlug == null || (d.pieceSlug is string && d.pieceSlug.size() <= 200))
          && d.source is string && d.source.size() <= 40
          && d.status == 'nuevo'
          && d.createdAt == request.time;
    }

    // ─── Pieces (products) ─────────────────────────────────────────────────────

    match /pieces/{pieceId} {
      allow read: if true;                                 // Public: anyone can browse
      allow create: if isEditor() && pieceCreateValid();   // S6: editor+ con campos válidos
      allow update: if isEditor() && pieceTypesValid();    // S6: tolerante a merge/partial
      allow delete: if isAdmin();                          // Admin+ can delete
    }

    // ─── Collections (categories) ──────────────────────────────────────────────

    match /collections/{colId} {
      allow read: if true;                                 // Public
      allow create: if isEditor() && colCreateValid();     // S6
      allow update: if isEditor() && colTypesValid();      // S6: tolerante a merge/partial
      allow delete: if isAdmin();                          // Admin+
    }

    // ─── Reviews ───────────────────────────────────────────────────────────────

    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true || isAdmin();  // S5: público solo aprobadas; admin ve todas
      allow create: if reviewCreateValida();   // F6: forma exacta + nunca nace aprobada
      allow update, delete: if isAdmin();      // Admin+ moderates reviews
    }

    // ─── Subscriptions (newsletter) ────────────────────────────────────────────

    match /subscriptions/{subId} {
      allow read: if isAdmin();                // Admin only
      allow create: if subscriptionCreateValida(); // F6: email válido + forma exacta
      allow update, delete: if isAdmin();      // Admin manages
    }

    // ─── Inquiries (contact form leads) ────────────────────────────────────────

    match /inquiries/{inqId} {
      allow read: if isEditor();               // Editors+ can see leads
      allow create: if inquiryCreateValida();  // F6: forma exacta + status 'nuevo' forzado
      allow update: if isEditor();             // Mark as read, etc.
      allow delete: if isAdmin();              // Admin cleans up
    }

    // collectionGroup de `movimientos`: lectura para el aging/mora de la lista CxC
    // (ADR §51). Solo admin. Los WRITES siguen gobernados por el match anidado de
    // abajo (clientes/{id}/movimientos/{id}); este match SOLO concede lectura de grupo.
    match /{path=**}/movimientos/{movId} {
      allow read: if isAdmin();
    }

    // ─── CRM: clientes y movimientos (cuentas por cobrar) — SOLO admin/owner ─────
    match /clientes/{clienteId} {
      allow read:   if isAdmin();
      allow create: if isAdmin() && clienteValido();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /movimientos/{movId} {
        allow read:   if isAdmin();
        allow create: if isAdmin() && movimientoValido();
        allow update: if isAdmin() && anulacionValida();   // append-only: SOLO anular (no editar el asiento)
        allow delete: if false;                            // libro append-only: NUNCA borrar (ni admin)
      }
    }

    // ─── CRM: vendedoras (entidad de datos que gestiona Kary) ────────────────────
    match /vendedoras/{vendedoraId} {
      allow read:           if isAdmin();
      allow create, update: if isAdmin() && vendedoraValida();
      allow delete:         if isAdmin();
    }

    // ─── CRM: pendientes de configuración / setup (tablero visible para Kary) ────
    match /pendientes/{id} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Users (role management) — SOLO OWNER ──────────────────────────────────
    // El panel escribe users/{uid} DIRECTO (js/auth.js) → las REGLAS son la única
    // frontera server-side (las CFs callable con guardas NO están en ese camino;
    // y las que sí lo están corren con Admin SDK, que SALTA estas reglas).
    // Gestión de usuarios = OWNER-only (la página es `requireAuth('owner')`). Un
    // admin NO escribe docs de usuario: así no puede reescribir el `role` de otros
    // ni tocar al owner (§66) — y sin esto el trigger `syncRoleClaim` sellaría un
    // claim REAL escalado (§65). `role:'owner'` no se acuña desde la app (seed/consola).
    function usersFieldsValidos() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'displayName', 'role', 'active',
                               'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
                               'lastLogin', 'deactivatedAt', 'deactivatedBy'])
          && (!('role' in d)   || d.role in ['owner', 'admin', 'editor'])
          && (!('active' in d) || d.active is bool);
    }

    match /users/{userId} {
      allow read:   if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isOwner() && usersFieldsValidos()
                    && request.resource.data.role in ['admin', 'editor'];
      allow update: if isOwner() && usersFieldsValidos();   // solo el owner muta usuarios
      allow delete: if isOwner();
    }

    // ─── Config (site settings, status) ────────────────────────────────────────

    match /config/{docId} {
      // Solo `config/status` es público (health-check de la web, js/firestore-service.js).
      // El resto (parámetros del negocio: fechaCorteMigracion, datos fiscales) = admin.
      allow read:  if docId == 'status' || isAdmin();
      allow write: if isAdmin();               // CRM: endurecido owner→admin (Kary edita config)
    }

    // ─── Push Tokens ───────────────────────────────────────────────────────────

    // F6 frenos de gasto: NINGÚN código escribe push_tokens hoy (verificado por grep
    // js/ + functions/ 2026-06-09) — era una puerta pública sin uso legítimo (spam).
    // Cuando aterrice FCM, reabrir create con validación de forma (como los forms).
    match /push_tokens/{tokenId} {
      allow read: if isAdmin();                // Admin sees subscribers
      allow create, update: if false;          // cerrado: sin writer legítimo en el código
      allow delete: if isAdmin();
    }

    // ─── Salud del sistema (F6 frente D): escrita SOLO por Cloud Functions ──────
    // `salud/backup` + `salud/reconciliacion` (singletons, pisar no apilar). El
    // Admin SDK de las CFs NO pasa por estas reglas → write:false cierra al cliente.
    // Acceso ADMIN deliberado (no owner-only): Kary puede operar la red de seguridad
    // si hace falta; solo la ENTRADA del menú es owner (UI ≠ frontera de seguridad).
    match /salud/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // Eventos de fallo (p.ej. recalc-saldo-error). El panel solo puede MARCARLOS
    // como resueltos (whitelist de 3 claves + resuelto false→true UNA sola vez +
    // sello de tiempo del SERVIDOR, espejo de anulacionValida) — el contenido del
    // evento es testimonio inmutable, como la anulación de movimientos.
    match /saludEventos/{eventoId} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['resuelto', 'resueltoEn', 'resueltoPor'])
          && resource.data.get('resuelto', false) == false
          && request.resource.data.resuelto == true
          && request.resource.data.resueltoEn == request.time
          && request.resource.data.resueltoPor == request.auth.uid;
    }
  }
}
