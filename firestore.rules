rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    // F6 frente B (RBAC claims): el rol se lee PRIMERO del custom claim del token
    // (cero lecturas extra, S4) con fallback dual al doc users/{uid} durante la
    // transición (usuario sin backfill / claim aún no en el token). El claim lo
    // espeja SOLO la CF syncRoleClaim desde users/{uid}.role (fuente de verdad).
    // PRECEDENCIA: si el claim existe, MANDA (un claim desactualizado dura ≤1h de
    // token). Deprecar el fallback a +30 días del backfill (ADR §65).
    function getUserRole() {
      let claim = request.auth.token.get('role', null);
      return claim != null
          ? claim
          : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOwner() {
      return isAuth() && getUserRole() == 'owner';
    }

    function isAdmin() {
      return isAuth() && getUserRole() in ['owner', 'admin'];
    }

    function isEditor() {
      return isAuth() && getUserRole() in ['owner', 'admin', 'editor'];
    }

    // ─── CRM (cuentas por cobrar): validadores ───────────────────────────────────
    function nonEmptyStr(v) { return v is string && v.size() > 0; }
    // Optativos con el idiom seguro `!('campo' in d) || ...` (ver nota de S6: el
    // acceso a un campo ausente lanza error en reglas → presencia primero).
    // `hasOnly` = whitelist anti-inyección: bloquea saldoActual (lo escribe SOLO la
    // Cloud Function vía el movimiento de apertura) y cualquier campo no previsto.
    function clienteValido() {
      let d = request.resource.data;
      return nonEmptyStr(d.nombre)
          && d.keys().hasOnly(['nombre', 'telefono', 'whatsapp', 'cumpleanos', 'notas',
                               'vendedoraId', 'asesorId', 'origen', 'activo',
                               'createdAt', 'createdBy', 'updatedAt'])
          && (!('vendedoraId' in d) || d.vendedoraId is string)
          // asesorId (spec acuerdos §1.6): costura para el asesor de cobranza
          // FUTURO — espejo del patrón vendedoraId (entidad/atributo primero,
          // usuario después, TODO-19). Sin UI hoy; el campo viaja en este deploy.
          && (!('asesorId' in d)    || d.asesorId is string)
          && (!('telefono' in d)    || d.telefono is string);
    }
    // Vendedora = entidad de datos que gestiona Kary (no es un usuario auth).
    function vendedoraValida() {
      let d = request.resource.data;
      return nonEmptyStr(d.nombre)
          && d.keys().hasOnly(['nombre', 'activa', 'createdAt', 'createdBy', 'updatedAt'])
          && (!('activa' in d) || d.activa is bool);
    }
    // ─── Fase M · M3 (candado, §69 + Consejo Externo Gemini 2026-06-11) ──────────
    // Fecha del HECHO ('YYYY-MM-DD'): formato ISO + cotas. La cota FUTURA cierra la
    // evasión del aging que halló el Consejo (una factura fechada en 2030 nunca
    // "vence" → deuda parqueada fuera de la mora); +2 días de tolerancia de huso.
    // El piso grueso atrapa el dedazo de año. timestamp.date() revienta con fechas
    // de calendario inválidas (2026-02-30) → error → DENY (falla cerrado).
    function fechaHechoValida(f) {
      return f is string && f.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && f >= '2015-01-01'
          && timestamp.date(int(f.split('-')[0]), int(f.split('-')[1]), int(f.split('-')[2]))
               <= request.time + duration.value(2, 'd');
    }
    // Gate del AJUSTE por su EFECTO en el saldo (política A.2/A.4): motivo de lista
    // CERRADA + nota SIEMPRE; el negativo del admin solo con motivo NEUTRO y dentro
    // del tope. El get() a config/cartera vive SOLO aquí, tras el cortocircuito
    // (el owner JAMÁS depende del doc; el camino diario factura/abono JAMÁS lo lee).
    // Sin abs() en rules (Consejo M3): el tope negativo se escribe con signo.
    // La TAXONOMÍA de motivos es literal (contrato estable); el subconjunto NEUTRO
    // sí se lee de config/cartera (red-team M3: el panel Parámetros owner-only lo
    // edita y la UI enruta con él — dos fuentes de verdad = falso bloqueo latente).
    // El get() vive SOLO en la rama del admin (mismo doc que el tope = una lectura);
    // el owner JAMÁS lo toca (anti-lockout intacto). Default = los 3 canónicos.
    function ajusteAutorizado(d) {
      return d.motivo in ['ERROR_REGISTRO', 'ABONO_NO_REGISTRADO', 'RECLASIFICACION',
                          'DEVOLUCION_PIEZA', 'DESCUENTO_AUTORIZADO', 'CASTIGO', 'OTRO']
          && nonEmptyStr(d.nota)
          && (isOwner()
              || d.monto >= 0
              || (d.motivo in get(/databases/$(database)/documents/config/cartera).data
                    .get('motivosNeutros', ['ERROR_REGISTRO', 'ABONO_NO_REGISTRADO', 'RECLASIFICACION'])
                  && d.monto >= -get(/databases/$(database)/documents/config/cartera).data.autoAprobacionMax));
    }
    // COINCIDENCIA solicitud↔asiento (enmienda M2b §76, deferido 4): un asiento que
    // porta `solicitudId` solo lo crea el OWNER y debe coincidir con la solicitud
    // PENDIENTE (estado PRE-batch, §69 C3) POR TIPO de solicitud: ajuste → tipo/
    // monto/motivo idénticos; corrección → contra el REEMPLAZO embebido (el monto
    // top-level de la solicitud es el DELTA neto, no el monto del asiento). El get()
    // está ANCLADO al path del MISMO cliente → el hijacking cross-cliente es
    // imposible por construcción (404 → error → deny; caso rojo del Consejo M3).
    function asientoCoincideConSolicitud(clienteId, d) {
      let s = get(/databases/$(database)/documents/clientes/$(clienteId)/solicitudes/$(d.solicitudId)).data;
      return isOwner()
          && s.estado == 'pendiente'
          && (
            (s.tipo == 'ajuste'
              && d.tipo == 'ajuste' && d.monto == s.monto && d.motivo == s.motivo)
            ||
            (s.tipo == 'correccion'
              && d.tipo == s.datosCorreccion.reemplazo.tipo
              && d.monto == s.datosCorreccion.reemplazo.monto
              && d.correccionDe == s.correccionDe)
          );
    }
    // CREATE endurecido (contract M3): whitelist hasOnly cierra la inyección de
    // claves; registradoEn == request.time = reloj del SERVIDOR (retrofechar `fecha`
    // no evade la auditoría); fecha OBLIGATORIA en asientos nuevos (los legacy ya
    // existentes no pasan por aquí — censo 2026-06-11: 344/344 con fecha ISO sana).
    // El signo lo da el `tipo` (factura/apertura/ajuste suman; abono resta).
    function movimientoValido(clienteId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'monto', 'descripcion', 'fecha', 'registradoPor',
                               'registradoEn', 'anulado', 'motivo', 'nota', 'solicitudId',
                               'correccionDe', 'vencimiento', 'medioPago'])
          && d.tipo in ['apertura', 'factura', 'abono', 'ajuste']
          // entero-COP (spec §5.1): pesos SIN centavos. JS envía números enteros como
          // int; un decimal llega como double y se RECHAZA en la frontera de escritura.
          && d.monto is int
          && (d.tipo in ['apertura', 'ajuste'] || d.monto >= 0)
          // M0-H (§69): apertura NEGATIVA reduce saldo sin motivo ni tope → owner-only.
          && (d.tipo != 'apertura' || d.monto >= 0 || isOwner())
          && (!('descripcion' in d) || (d.descripcion is string && d.descripcion.size() <= 500))
          && fechaHechoValida(d.fecha)
          // vencimiento (M6, opcional): SOLO facturas; puede ser futuro (es su uso) —
          // formato + piso, sin cota futura.
          && (!('vencimiento' in d) || (d.tipo == 'factura' && d.vencimiento is string
                && d.vencimiento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.vencimiento >= '2015-01-01'))
          && d.registradoPor == request.auth.uid
          && d.registradoEn == request.time
          && d.anulado == false
          // abono: medioPago obligatorio de lista LITERAL (cero get en el camino diario,
          // decisión C2 §69); en los demás tipos el campo NO viaja.
          && (d.tipo != 'abono' || d.medioPago in ['efectivo', 'transferencia', 'datafono', 'otro'])
          && (!('medioPago' in d) || d.tipo == 'abono')
          && (!('motivo' in d) || (nonEmptyStr(d.motivo) && d.motivo.size() <= 500))
          && (!('nota' in d) || (d.nota is string && d.nota.size() <= 500))
          && (!('correccionDe' in d) || d.correccionDe is string)
          && (d.tipo != 'ajuste' || ajusteAutorizado(d))
          && (!('solicitudId' in d) || asientoCoincideConSolicitud(clienteId, d));
    }
    // ─── Fase M (M1 §69): validadores de solicitudes y gestiones ─────────────────
    // Solicitud de aprobación: nace 'pendiente', con autor y reloj del SERVIDOR
    // (creadoEn == request.time ⇒ solo serverTimestamp()). `tipo` 'ajuste' = pide
    // un asiento nuevo; 'correccion' = pide el par anular+crear (datosCorreccion).
    function solicitudValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'monto', 'motivo', 'nota', 'fecha',
                               'solicitadoPor', 'creadoEn', 'estado',
                               'correccionDe', 'datosCorreccion', 'saldoAlSolicitar'])
          && d.estado == 'pendiente'
          && d.tipo in ['ajuste', 'correccion']
          && d.monto is int
          && nonEmptyStr(d.motivo) && d.motivo.size() <= 500
          && nonEmptyStr(d.nota) && d.nota.size() <= 500
          && d.solicitadoPor == request.auth.uid
          && d.creadoEn == request.time
          && (!('fecha' in d) || (d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (!('correccionDe' in d)    || d.correccionDe is string)
          && (!('datosCorreccion' in d) || d.datosCorreccion is map)
          && (!('saldoAlSolicitar' in d) || d.saldoAlSolicitar is int);
    }
    // Transiciones ONE-WAY desde 'pendiente' (espejo de saludEventos):
    //  · owner → aprobada/rechazada (sello server-time + autor). Estado y campo van
    //    ATADOS (ADR §72): rechazo EXIGE motivoRechazo; aprobación NO lo porta — un
    //    guard `(A || B)` con hasOnly que whitelista B dejaba pasar 'aprobada'+motivoRechazo
    //    (estado contradictorio que M2b leería); el ternario por presencia lo cierra.
    //  · la SOLICITANTE → cancelada (nadie cancela solicitudes ajenas)
    function transicionSolicitudValida() {
      let d = request.resource.data;
      return resource.data.estado == 'pendiente'
          && (
            (isOwner()
              && d.estado in ['aprobada', 'rechazada']
              && d.diff(resource.data).affectedKeys()
                   .hasOnly(['estado', 'resueltoPor', 'resueltoEn', 'motivoRechazo'])
              && d.resueltoPor == request.auth.uid
              && d.resueltoEn == request.time
              && (d.estado == 'rechazada' ? nonEmptyStr(d.motivoRechazo) : !('motivoRechazo' in d)))
            ||
            (d.estado == 'cancelada'
              && resource.data.solicitadoPor == request.auth.uid
              && d.diff(resource.data).affectedKeys()
                   .hasOnly(['estado', 'canceladoPor', 'canceladoEn'])
              && d.canceladoPor == request.auth.uid
              && d.canceladoEn == request.time)
          );
    }
    // Gestión de cobro: tipo y resultado de listas LITERALES (cero get() a config
    // en el camino diario — decisión C2 §69); fecha del hecho + reloj del servidor.
    // size() en texto libre (deferido verif. M5): docs INMUTABLES no deben poder
    // cargar strings de cientos de KB que el expediente arrastraría para siempre.
    function gestionValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'nota', 'fecha', 'resultado',
                               'registradoPor', 'creadoEn', 'soporte'])
          && d.tipo in ['llamada', 'whatsapp', 'visita', 'otro']
          && d.resultado in ['promesa_pago', 'sin_acuerdo', 'no_contesto', 'numero_invalido', 'otro']
          && d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (!('nota' in d)    || (d.nota is string && d.nota.size() <= 500))
          && (!('soporte' in d) || (d.soporte is string && d.soporte.size() <= 500))
          && d.registradoPor == request.auth.uid
          && d.creadoEn == request.time;
    }
    // ─── Acuerdos de pago v2 (spec 2026-06-12, Consejo Externo): MUTEX ──────────
    // El acuerdo NO mueve dinero (el libro es `movimientos`, el saldo lo escribe la
    // CF): pacta CUÁNDO es exigible TODA la deuda actual (solo SALDO — el FIFO
    // global no atribuye por factura). Cuotas EMBEBIDAS. Las reglas NO iteran
    // cuotas[]: validan el "sobre"; la verdad la valida acuerdoEsValido() en el
    // archivo de paridad (inválido = IGNORADO = más vencido = conservador).
    // CANDADO (mutex): la VERDAD de "cuál acuerdo está vigente" es el puntero
    // `acuerdoVigenteId` en el doc del cliente. Crear un acuerdo EXIGE que, tras el
    // batch, el cliente apunte a ESTE id → imposible el "acuerdo suelto" que ocultaba
    // mora (vector de jineteo del Consejo). getUserRole() no toca el camino diario.
    function acuerdoValido(clienteId, acuerdoId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['fechaPacto', 'cuotas',
                               'periodicidad', 'primeraCuotaFecha', 'ultimaCuotaFecha',
                               'saldoAlPactar', 'nota', 'estado', 'reemplazaA',
                               'creadoPor', 'creadoEn', 'rolAlCrear'])
          && d.estado == 'vigente'
          && fechaHechoValida(d.fechaPacto)
          && d.cuotas is list && d.cuotas.size() >= 1 && d.cuotas.size() <= 36
          && nonEmptyStr(d.nota) && d.nota.size() <= 500
          && (!('periodicidad' in d)  || d.periodicidad in ['quincenal', 'mensual', 'fechas'])
          && (!('saldoAlPactar' in d) || d.saldoAlPactar is int)
          && d.primeraCuotaFecha is string && d.primeraCuotaFecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.ultimaCuotaFecha is string && d.ultimaCuotaFecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.primeraCuotaFecha >= d.fechaPacto
          && d.ultimaCuotaFecha >= d.primeraCuotaFecha
          && d.creadoPor == request.auth.uid
          && d.creadoEn == request.time
          // Investidura probatoria: el rol DE AQUEL MOMENTO sellado (costura asesor §1.6).
          && d.rolAlCrear == getUserRole()
          // MUTEX: el cliente DEBE apuntarme tras el batch (fuerza la actualización
          // del puntero en la MISMA transacción → no existe el acuerdo suelto).
          && getAfter(/databases/$(database)/documents/clientes/$(clienteId)).data.get('acuerdoVigenteId', '') == acuerdoId
          // RENEGOCIACIÓN ATÓMICA: crear con reemplazaA exige que EN EL MISMO BATCH
          // el viejo quede sellado 'reemplazado' apuntando de vuelta.
          && (!('reemplazaA' in d) ||
              (nonEmptyStr(d.reemplazaA)
               && getAfter(/databases/$(database)/documents/clientes/$(clienteId)/acuerdos/$(d.reemplazaA)).data.estado == 'reemplazado'
               && getAfter(/databases/$(database)/documents/clientes/$(clienteId)/acuerdos/$(d.reemplazaA)).data.reemplazadoPor == acuerdoId));
    }
    // Cierre ONE-WAY desde 'vigente', gobernado por el MUTEX del cliente:
    //   · vigente→reemplazado: admin, y el puntero del cliente YA NO me apunta
    //     (se movió al nuevo en el mismo batch — sin sello suelto).
    //   · vigente→anulado: SOLO OWNER con motivo, y el puntero quedó en null
    //     ("cancelar" = goma de borrar del cronograma; espejo de anular-abonos).
    function transicionAcuerdoValida(clienteId, acuerdoId) {
      let d = request.resource.data;
      let ptr = getAfter(/databases/$(database)/documents/clientes/$(clienteId)).data.get('acuerdoVigenteId', '');
      return resource.data.estado == 'vigente'
          && d.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'cerradoPor', 'cerradoEn', 'motivoCierre', 'reemplazadoPor'])
          && d.cerradoPor == request.auth.uid
          && d.cerradoEn == request.time
          && (
            (d.estado == 'reemplazado' && isAdmin() && nonEmptyStr(d.reemplazadoPor) && ptr != acuerdoId)
            ||
            (d.estado == 'anulado' && isOwner()
             && nonEmptyStr(d.motivoCierre) && d.motivoCierre.size() <= 500 && ptr == '')
          );
    }
    // MUTEX en el doc del cliente: valida la transición del puntero `acuerdoVigenteId`
    // (el resto de campos del cliente NO la disparan). null='' (ausente o vacío).
    //   null→new : 1er acuerdo (admin)   — el nuevo queda 'vigente'.
    //   old →new : renegociación (admin) — nuevo 'vigente' + viejo 'reemplazado'.
    //   old →null: anulación (OWNER)     — el viejo queda 'anulado'.
    function mutexAcuerdoValido(clienteId) {
      let viejo = resource.data.get('acuerdoVigenteId', '');
      let nuevo = request.resource.data.get('acuerdoVigenteId', '');
      return viejo == nuevo
          ? true
          : (
            (viejo == '' && nuevo != '' && isAdmin()
             && getAfter(/databases/$(database)/documents/clientes/$(clienteId)/acuerdos/$(nuevo)).data.estado == 'vigente')
            ||
            (viejo != '' && nuevo != '' && isAdmin()
             && getAfter(/databases/$(database)/documents/clientes/$(clienteId)/acuerdos/$(nuevo)).data.estado == 'vigente'
             && getAfter(/databases/$(database)/documents/clientes/$(clienteId)/acuerdos/$(viejo)).data.estado == 'reemplazado')
            ||
            (viejo != '' && nuevo == '' && isOwner()
             && getAfter(/databases/$(database)/documents/clientes/$(clienteId)/acuerdos/$(viejo)).data.estado == 'anulado')
          );
    }

    // Append-only: el ÚNICO update permitido sobre un movimiento es ANULARLO
    // (anulado false→true) + sellar auditoría. La validación es del DELTA
    // (affectedKeys), NUNCA del estado resultante → los asientos legacy "sucios"
    // siguen siendo anulables (Consejo M3). `.get('anulado', false)` tolera legacy.
    // M3 (contract, §69-B): motivoCategoria OBLIGATORIO de lista cerrada + GATE por
    // el EFECTO de revertir, leyendo resource.data (tipo/monto NO están en el delta):
    //   · anular un ABONO (cualquier monto) → SOLO owner — es la herramienta del
    //     skimming de efectivo; el "grace period" del Consejo se REFUTÓ (política A.3).
    //   · factura/apertura/ajuste con monto > 0 y ≤ tope → admin; > tope → owner.
    //   · monto ≤ 0 o no-entero → owner (anularlo revierte una reducción aprobada;
    //     falla CERRADO). Cortocircuito anti-lockout: el owner JAMÁS lee config.
    // `corregidoPor` NO se verifica contra un doc real por diseño (sin cross-doc,
    // §69; M4 audita "corrección sin enlace" de forma detectiva).
    function anulacionValida() {
      let d = request.resource.data;
      return resource.data.get('anulado', false) == false
          && d.anulado == true
          && d.anuladoPor == request.auth.uid
          && d.anuladoEn == request.time
          && nonEmptyStr(d.motivoAnulacion)
          // Lista = UNIÓN de los motivos de anulación pura + los que el flujo de
          // CORRECCIÓN deriva del mostrador (red-team M3: ABONO_NO_REGISTRADO y
          // DESCUENTO_AUTORIZADO viajan como motivoCategoria de la pata anulada).
          && d.motivoCategoria in ['ERROR_REGISTRO', 'DUPLICADO', 'CORRECCION',
                                   'CORRECCION_FECHA', 'DEVOLUCION_PIEZA',
                                   'ABONO_NO_REGISTRADO', 'DESCUENTO_AUTORIZADO', 'OTRO']
          && (!('corregidoPor' in d) || d.corregidoPor is string)
          && d.diff(resource.data).affectedKeys()
               .hasOnly(['anulado', 'anuladoPor', 'anuladoEn', 'motivoAnulacion',
                         'motivoCategoria', 'corregidoPor'])
          && (isOwner()
              || (resource.data.tipo in ['factura', 'apertura', 'ajuste']
                  && resource.data.monto is int && resource.data.monto > 0
                  && resource.data.monto <= get(/databases/$(database)/documents/config/cartera).data.autoAprobacionMax));
    }

    // ─── S6: validación de campos (tolerante a merge/partial updates) ────────────
    // En update con merge, request.resource.data = estado RESULTANTE completo, por
    // eso en `update` solo validamos TIPOS si el campo está presente (no exigimos
    // presencia → no rompe patches de imágenes ni docs legacy). En `create` sí
    // exigimos los obligatorios (name/code que el form de admin garantiza).
    // NOTA (reglas Firestore): acceder a un campo AUSENTE lanza error de evaluación
    // ("Property X is undefined on object") → NO usar `d.campo == null` para opcionales.
    // Idiom correcto: `!('campo' in d) || d.campo is <tipo>` (presencia primero).
    function pieceCreateValid() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0
          && d.code is string && d.code.size() > 0
          && (!('price' in d)    || d.price is number)
          && (!('featured' in d) || d.featured is bool)
          && (!('images' in d)   || d.images is list)
          && (!('specs' in d)    || d.specs is map);
    }
    function pieceTypesValid() {
      let d = request.resource.data;
      return (!('name' in d)       || d.name is string)
          && (!('code' in d)       || d.code is string)
          && (!('slug' in d)       || d.slug is string)
          && (!('collection' in d) || d.collection is string)
          && (!('featured' in d)   || d.featured is bool)
          && (!('price' in d)      || d.price is number)
          && (!('images' in d)     || d.images is list)
          && (!('specs' in d)      || d.specs is map);
    }
    function colCreateValid() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0
          && (!('featured' in d) || d.featured is bool);
    }
    function colTypesValid() {
      let d = request.resource.data;
      return (!('name' in d)     || d.name is string)
          && (!('slug' in d)     || d.slug is string)
          && (!('subtitle' in d) || d.subtitle is string)
          && (!('featured' in d) || d.featured is bool);
    }

    // ─── F6 frenos de gasto: forms públicos con forma EXACTA (anti spam / denial-of-wallet) ──
    // Whitelist de claves + tipos + tamaños máximos + serverTimestamp obligatorio
    // (`createdAt == request.time` ⇒ solo pasa serverTimestamp(), nunca fechas del cliente).
    // Payload espejo en js/firestore-service.js (submitReview / addSubscription / saveInquiry).
    function reviewCreateValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['pieceSlug', 'pieceName', 'author', 'rating', 'comment', 'email', 'approved', 'createdAt'])
          && nonEmptyStr(d.author)  && d.author.size()  <= 120
          && nonEmptyStr(d.comment) && d.comment.size() <= 2000
          && d.rating is number && d.rating >= 1 && d.rating <= 5
          && d.approved == false
          && (!('pieceSlug' in d) || (d.pieceSlug is string && d.pieceSlug.size() <= 200))
          && (!('pieceName' in d) || (d.pieceName is string && d.pieceName.size() <= 200))
          && (!('email' in d)     || (d.email is string && d.email.size() <= 254))
          && d.createdAt == request.time;
    }
    function subscriptionCreateValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'source', 'createdAt', 'active'])
          && d.email is string && d.email.size() >= 5 && d.email.size() <= 254
          && d.email.matches('^[^@]+@[^@]+[.][^@]+$')
          && (!('source' in d) || (d.source is string && d.source.size() <= 40))
          && (!('active' in d) || d.active == true)
          && d.createdAt == request.time;
    }
    function inquiryCreateValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'phone', 'message', 'pieceSlug', 'source', 'status', 'createdAt'])
          && nonEmptyStr(d.name)    && d.name.size()    <= 120
          && nonEmptyStr(d.message) && d.message.size() <= 3000
          && (!('email' in d) || (d.email is string && d.email.size() <= 254))
          && (!('phone' in d) || (d.phone is string && d.phone.size() <= 30))
          && (!('pieceSlug' in d) || d.pieceSlug == null || (d.pieceSlug is string && d.pieceSlug.size() <= 200))
          && d.source is string && d.source.size() <= 40
          && d.status == 'nuevo'
          && d.createdAt == request.time;
    }

    // ─── Pieces (products) ─────────────────────────────────────────────────────

    match /pieces/{pieceId} {
      allow read: if true;                                 // Public: anyone can browse
      allow create: if isEditor() && pieceCreateValid();   // S6: editor+ con campos válidos
      allow update: if isEditor() && pieceTypesValid();    // S6: tolerante a merge/partial
      allow delete: if isAdmin();                          // Admin+ can delete
    }

    // ─── Collections (categories) ──────────────────────────────────────────────

    match /collections/{colId} {
      allow read: if true;                                 // Public
      allow create: if isEditor() && colCreateValid();     // S6
      allow update: if isEditor() && colTypesValid();      // S6: tolerante a merge/partial
      allow delete: if isAdmin();                          // Admin+
    }

    // ─── Reviews ───────────────────────────────────────────────────────────────

    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true || isAdmin();  // S5: público solo aprobadas; admin ve todas
      allow create: if reviewCreateValida();   // F6: forma exacta + nunca nace aprobada
      allow update, delete: if isAdmin();      // Admin+ moderates reviews
    }

    // ─── Subscriptions (newsletter) ────────────────────────────────────────────

    match /subscriptions/{subId} {
      allow read: if isAdmin();                // Admin only
      allow create: if subscriptionCreateValida(); // F6: email válido + forma exacta
      allow update, delete: if isAdmin();      // Admin manages
    }

    // ─── Inquiries (contact form leads) ────────────────────────────────────────

    match /inquiries/{inqId} {
      allow read: if isEditor();               // Editors+ can see leads
      allow create: if inquiryCreateValida();  // F6: forma exacta + status 'nuevo' forzado
      allow update: if isEditor();             // Mark as read, etc.
      allow delete: if isAdmin();              // Admin cleans up
    }

    // collectionGroup de `movimientos`: lectura para el aging/mora de la lista CxC
    // (ADR §51). Solo admin. Los WRITES siguen gobernados por el match anidado de
    // abajo (clientes/{id}/movimientos/{id}); este match SOLO concede lectura de grupo.
    match /{path=**}/movimientos/{movId} {
      allow read: if isAdmin();
    }

    // collectionGroup de `solicitudes`: la cola de aprobación de Daniel (M2b) lee
    // TODAS las pendientes cruzando clientas. Índice COLLECTION_GROUP declarado en
    // firestore.indexes.json (estado ASC, creadoEn ASC) — sin él, FAILED_PRECONDITION.
    match /{path=**}/solicitudes/{solId} {
      allow read: if isAdmin();
    }

    // collectionGroup de `gestiones`: conteos del expediente de castigo (M5/M7).
    match /{path=**}/gestiones/{gestId} {
      allow read: if isAdmin();
    }

    // collectionGroup de `acuerdos`: el corte mensual y la agenda de cobro cruzan
    // clientas (spec 2026-06-12; índice CG en firestore.indexes.json).
    match /{path=**}/acuerdos/{acuerdoId} {
      allow read: if isAdmin();
    }

    // ─── CRM: clientes y movimientos (cuentas por cobrar) — SOLO admin/owner ─────
    match /clientes/{clienteId} {
      allow read:   if isAdmin();
      allow create: if isAdmin() && clienteValido();
      // M0-H (Fase M §69): whitelist en UPDATE — cierra `saldoActual` (lo escribe
      // SOLO la CF recalcSaldoCliente; antes un admin podía pisarlo a mano).
      // `acuerdoVigenteId` (mutex de acuerdos v2): en la whitelist, pero su cambio
      // SOLO es válido como parte de una transición de acuerdo (mutexAcuerdoValido).
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['nombre', 'telefono', 'whatsapp', 'cumpleanos', 'notas',
                                   'vendedoraId', 'asesorId', 'origen', 'activo',
                                   'acuerdoVigenteId',
                                   'createdAt', 'createdBy', 'updatedAt'])
                    && mutexAcuerdoValido(clienteId);
      allow delete: if isAdmin();

      match /movimientos/{movId} {
        allow read:   if isAdmin();
        allow create: if isAdmin() && movimientoValido(clienteId);
        allow update: if isAdmin() && anulacionValida();   // append-only: SOLO anular (no editar el asiento)
        allow delete: if false;                            // libro append-only: NUNCA borrar (ni admin)
      }

      // ─── Fase M (M1 §69): solicitudes de aprobación — "el asiento nace solo al
      // aprobarse". Kary crea la solicitud (nace 'pendiente', sellada por el reloj
      // del SERVIDOR); SOLO Daniel la transiciona a aprobada/rechazada (one-way,
      // espejo de saludEventos); solo la SOLICITANTE puede cancelar la suya.
      // El asiento real lo crea Daniel al aprobar (M2b); el saldo no se toca antes.
      match /solicitudes/{solId} {
        allow read:   if isAdmin();
        allow create: if isAdmin() && solicitudValida();
        allow update: if isAdmin() && transicionSolicitudValida();
        allow delete: if false;                            // el ciclo completo queda en el libro
      }

      // ─── Fase M (M1 §69): gestiones de cobro — evidencia del expediente de
      // castigo (art. 146 ET). INMUTABLES: una equivocación se aclara con OTRA
      // gestión, nunca editando la anterior.
      match /gestiones/{gestId} {
        allow read:   if isAdmin();
        allow create: if isAdmin() && gestionValida();
        allow update, delete: if false;
      }

      // ─── Acuerdos de pago (spec 2026-06-12): el plan de cuotas pactado ─────────
      // Evidencia art. 146: JAMÁS se borra. Renegociar = batch atómico (nuevo con
      // reemplazaA + viejo sellado); anular = SOLO owner (la goma de borrar).
      match /acuerdos/{acuerdoId} {
        allow read:   if isAdmin();
        allow create: if isAdmin() && acuerdoValido(clienteId, acuerdoId);
        allow update: if isAuth() && transicionAcuerdoValida(clienteId, acuerdoId);
        allow delete: if false;
      }
    }

    // ─── CRM: vendedoras (entidad de datos que gestiona Kary) ────────────────────
    match /vendedoras/{vendedoraId} {
      allow read:           if isAdmin();
      allow create, update: if isAdmin() && vendedoraValida();
      allow delete:         if isAdmin();
    }

    // ─── CRM: pendientes de configuración / setup (tablero visible para Kary) ────
    match /pendientes/{id} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Users (role management) — SOLO OWNER ──────────────────────────────────
    // El panel escribe users/{uid} DIRECTO (js/auth.js) → las REGLAS son la única
    // frontera server-side (las CFs callable con guardas NO están en ese camino;
    // y las que sí lo están corren con Admin SDK, que SALTA estas reglas).
    // Gestión de usuarios = OWNER-only (la página es `requireAuth('owner')`). Un
    // admin NO escribe docs de usuario: así no puede reescribir el `role` de otros
    // ni tocar al owner (§66) — y sin esto el trigger `syncRoleClaim` sellaría un
    // claim REAL escalado (§65). `role:'owner'` no se acuña desde la app (seed/consola).
    function usersFieldsValidos() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'displayName', 'role', 'active',
                               'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
                               'lastLogin', 'deactivatedAt', 'deactivatedBy'])
          && (!('role' in d)   || d.role in ['owner', 'admin', 'editor'])
          && (!('active' in d) || d.active is bool);
    }

    match /users/{userId} {
      allow read:   if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isOwner() && usersFieldsValidos()
                    && request.resource.data.role in ['admin', 'editor'];
      allow update: if isOwner() && usersFieldsValidos();   // solo el owner muta usuarios
      allow delete: if isOwner();
    }

    // ─── Config (site settings, status) ────────────────────────────────────────

    match /config/{docId} {
      // Solo `config/status` es público (health-check de la web, js/firestore-service.js).
      // El resto (parámetros del negocio: fechaCorteMigracion, datos fiscales) = admin.
      // EXCEPCIÓN M0 (Fase M §69): `config/cartera` guarda los LÍMITES que gobiernan
      // a la operadora (tope de auto-aprobación, motivos, criterios de castigo) —
      // write OWNER-ONLY: quien opera bajo los límites no puede reescribirlos.
      allow read:  if docId == 'status' || isAdmin();
      allow write: if docId == 'cartera' ? isOwner() : isAdmin();
    }

    // ─── Push Tokens ───────────────────────────────────────────────────────────

    // F6 frenos de gasto: NINGÚN código escribe push_tokens hoy (verificado por grep
    // js/ + functions/ 2026-06-09) — era una puerta pública sin uso legítimo (spam).
    // Cuando aterrice FCM, reabrir create con validación de forma (como los forms).
    match /push_tokens/{tokenId} {
      allow read: if isAdmin();                // Admin sees subscribers
      allow create, update: if false;          // cerrado: sin writer legítimo en el código
      allow delete: if isAdmin();
    }

    // ─── Salud del sistema (F6 frente D): escrita SOLO por Cloud Functions ──────
    // `salud/backup` + `salud/reconciliacion` (singletons, pisar no apilar). El
    // Admin SDK de las CFs NO pasa por estas reglas → write:false cierra al cliente.
    // Acceso ADMIN deliberado (no owner-only): Kary puede operar la red de seguridad
    // si hace falta; solo la ENTRADA del menú es owner (UI ≠ frontera de seguridad).
    match /salud/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // Eventos de fallo (p.ej. recalc-saldo-error). El panel solo puede MARCARLOS
    // como resueltos (whitelist de 3 claves + resuelto false→true UNA sola vez +
    // sello de tiempo del SERVIDOR, espejo de anulacionValida) — el contenido del
    // evento es testimonio inmutable, como la anulación de movimientos.
    match /saludEventos/{eventoId} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['resuelto', 'resueltoEn', 'resueltoPor'])
          && resource.data.get('resuelto', false) == false
          && request.resource.data.resuelto == true
          && request.resource.data.resueltoEn == request.time
          && request.resource.data.resueltoPor == request.auth.uid;
    }

    // ─── Fase M · M4 (§69): ACTA mensual de conciliación de recaudo ──────────────
    // Daniel concilia Σ(transferencias+datáfono) contra el extracto y ARQUEA el
    // efectivo (Kary no se arquea a sí misma — SoD mínimo); el resultado queda como
    // acta INMUTABLE one-way: create owner-only, sellada por el reloj del servidor,
    // docId = 'YYYY-MM'. Toda diferencia se trata por el flujo normal (ajuste/
    // solicitud), NUNCA editando el acta. update/delete false (testimonio).
    match /conciliaciones/{mes} {
      allow read: if isAdmin();
      allow create: if isOwner()
          && mes.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['mes', 'totalPorMedio', 'bancoCuadra',
                                                   'efectivoCuadra', 'diferencias',
                                                   'creadoPor', 'creadoEn'])
          && request.resource.data.mes == mes
          && request.resource.data.totalPorMedio is map
          && request.resource.data.bancoCuadra is bool
          && request.resource.data.efectivoCuadra is bool
          && request.resource.data.diferencias is string
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.creadoEn == request.time;
      allow update, delete: if false;
    }

    // ─── Fase M · M4 (§69 PR1): CORTE mensual inmutable del aging ────────────────
    // La foto estable por período (saldo/vencido/buckets/diasMora por clienta) que
    // soporta provisión (art. 145 ET), expediente de castigo y baseline — el libro
    // vivo se recomputa retroactivamente; la foto NO. La escribe SOLO la Cloud
    // Function programada (Admin SDK bypassa reglas); write:false cierra al cliente
    // (patrón salud/). read admin (la vista de Salud y futuros reportes la leen).
    match /cortes/{mes} {
      allow read:  if isAdmin();
      allow write: if false;
    }
  }
}
