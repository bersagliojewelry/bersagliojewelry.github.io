{
  "name": "bersaglio-jewelry",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "brain:check": "node scripts/brain-check.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bersaglio \"node --test tests/firestore-rules.test.mjs\"",
    "test:rules:run": "node --test tests/firestore-rules.test.mjs",
    "test:saldo": "node --test functions/saldo.test.mjs",
    "test:backup": "node --test functions/backup.test.mjs",
    "test:reconciliacion": "node --test functions/reconciliacion.test.mjs",
    "test:saldo:integration": "firebase emulators:exec --only firestore,functions --project demo-bersaglio \"node --test functions/saldo.integration.test.mjs\"",
    "test:sidebar": "node --test tests/render-sidebar.test.mjs",
    "test:truncado": "node --test tests/truncado.test.mjs",
    "test:parametros": "node --test tests/parametros-form.test.mjs",
    "test:estado": "node --test tests/estado-cuenta.test.mjs",
    "test:correccion": "node --test tests/crm-correccion.test.mjs",
    "test:aprobacion": "node --test tests/crm-aprobacion.test.mjs",
    "test:auditoria": "node --test tests/crm-auditoria.test.mjs",
    "test:gestiones": "node --test tests/crm-gestiones.test.mjs",
    "test:acuerdos": "node --test tests/acuerdos-aging.test.mjs",
    "test:insumos": "node --test tests/corte-insumos.test.mjs",
    "test:generador": "node --test tests/crm-acuerdos.test.mjs",
    "test:paridad": "node --test tests/aging-paridad.test.mjs",
    "test:leads": "node --test tests/lead-format.test.mjs",
    "brain:diff": "node scripts/brain-diff.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-admin": "^14.0.0",
    "lightningcss": "^1.32.0",
    "sharp-cli": "^5.2.0",
    "terser": "^5.46.1",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@studio-freight/lenis": "^1.0.42",
    "firebase": "^12.11.0",
    "gsap": "^3.14.2"
  }
}
